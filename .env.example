# OpenAI-compatible API
OPENAI_BASE_URL=https://your-openai-compatible-gateway.example.com/v1
OPENAI_API_KEY=replace-with-your-api-key
STAGE1_MODEL=replace-with-cheap-classifier-model
STAGE2_MODEL=replace-with-strong-scorer-model
REPORT_MODEL=replace-with-high-quality-report-model

# Daily run behavior
LOOKBACK_DAYS=3
MAX_REPORTS=8
STAGE1_CONFIDENCE_THRESHOLD=7
LLM_TIMEOUT_SECONDS=90
REPORT_TIMEOUT_SECONDS=420
REPORT_MAX_CHARS=90000
REPORT_LANGUAGE=zh
SEND_EMAIL=true
STATE_PATH=data/state.json
REPORT_DIR=reports
SKIP_SOURCES=false

# SMTP email. For QQ/163/enterprise mail, SMTP_PASSWORD is usually an app password or authorization code.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_USE_SSL=true
SMTP_STARTTLS=false
EMAIL_FROM=your-email@example.com
EMAIL_TO=recipient@example.com

# Optional source overrides, comma-separated URLs.
ANTHROPIC_URLS=https://www.anthropic.com/research
TRANSFORMER_CIRCUITS_URLS=https://transformer-circuits.pub/
ALIGNMENT_FORUM_URLS=https://www.alignmentforum.org/

# Reserved future delivery adapters.
NOTION_TOKEN=
NOTION_DATABASE_ID=
